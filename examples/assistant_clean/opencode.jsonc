// Ejemplo LIMPIO: minimo privilegio, MCP verificados, secretos por entorno.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "vendor/model-x",
  "permission": {
    "allow": [
      "read:src/*",
      "edit:src/**",
      "bash:git status"
    ],
    "deny": [
      "bash:rm -rf",
      "bash:curl"
    ]
  },
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@1.2.3"],
      "env": {
        "GITHUB_TOKEN": "env:GITHUB_TOKEN"
      },
      "verified": true
    }
  },
  "skills": {
    "skill-repo-audited@2.1.0": true
  }
}